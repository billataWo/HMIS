// HMIS core schema (MVP). Every tenant-owned table carries tenantId so that
// PostgreSQL row-level security can be layered on without schema changes.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Tenancy, users, audit ─────────────────────────────

enum FacilityType {
  CLINIC
  PHARMACY
  HOSPITAL
}

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  nameAm             String?
  type               FacilityType @default(CLINIC)
  phone              String?
  address            String?
  nextMrn            Int          @default(1) // per-facility counter for patient MRNs
  nextInvoice        Int          @default(1) // per-facility counter for invoice numbers
  // Pay before service: consultation before the doctor sees the patient, lab before the sample,
  // drugs before dispensing. Charges billed to a credit company or insurer count as settled.
  requirePrepayment  Boolean      @default(true)
  // Registration is a front-desk job; a clinic without a receptionist can let doctors do it too.
  doctorsCanRegister Boolean      @default(false)
  nextPo             Int          @default(1) // per-facility counter for purchase order numbers
  /// Stock kept in more than one place (a main store and a dispensary), moved by transfers.
  multiStore         Boolean      @default(false)
  nextTransfer       Int          @default(1) // per-facility counter for stock transfer numbers
  /// Target for urgent lab tests, sample taken to result released (minutes).
  labUrgentMinutes   Int          @default(60)
  /// The clinic's taxpayer identification number, printed on receipts.
  tin                String?
  createdAt          DateTime     @default(now())

  users         User[]
  patients      Patient[]
  appointments  Appointment[]
  visits        Visit[]
  drugs         Drug[]
  suppliers     Supplier[]
  prescriptions Prescription[]
  labTests      LabTest[]
  labOrders     LabOrder[]
  services      ServiceItem[]
  invoices      Invoice[]
  payments      Payment[]
  cashClosings  CashClosing[]
  auditLogs     AuditLog[]
  subscription  Subscription?
}

enum Role {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  CASHIER
  PHARMACIST
  LAB_TECH
}

model User {
  id                         String    @id @default(uuid())
  tenantId                   String
  tenant                     Tenant    @relation(fields: [tenantId], references: [id])
  fullName                   String
  phone                      String
  email                      String?
  passwordHash               String
  role                       Role
  /// Where this person sees patients ("Room 2", "OPD 1"): shown on the waiting-room screen when they call someone in.
  room                       String?
  active                     Boolean   @default(true)
  // Set when an admin creates the account or resets the password: the user must pick their own.
  mustChangePassword         Boolean   @default(false)
  /// A temporary password (set by an admin, mustChangePassword) stops working after this.
  temporaryPasswordExpiresAt DateTime?
  /// Sign-ins (tokens) issued before this are no longer accepted: set on a password change or
  /// reset, so a stolen or old sign-in stops working.
  sessionsValidAfter         DateTime?
  /// Two-step sign-in (authenticator app codes, RFC 6238). Required for admins.
  totpSecret                 String?
  /// Set while the app is being added, until the first code confirms it.
  totpPendingSecret          String?
  totpEnabledAt              DateTime?
  /// The last accepted 30-second step: each code works only once.
  totpLastStep               Int?
  /// SHA-256 hashes of the unused one-time recovery codes.
  totpRecoveryCodes          String[]  @default([])
  createdAt                  DateTime  @default(now())

  visitsAsDoctor  Visit[]        @relation("VisitDoctor")
  appointments    Appointment[]  @relation("AppointmentDoctor")
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  payments        Payment[]
  invoicesCreated Invoice[]      @relation("InvoiceCreatedBy")
  labCollected    LabOrder[]     @relation("LabCollectedBy")
  labResulted     LabOrder[]     @relation("LabResultedBy")
  labVerified     LabOrder[]     @relation("LabVerifiedBy")
  cashClosings    CashClosing[]

  @@unique([tenantId, phone])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  action    String // e.g. "patient.create", "invoice.void"
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}

// ───────────────────────────── Patients ─────────────────────────────

enum Sex {
  MALE
  FEMALE
}

model Patient {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  mrn               String // medical record number, unique per facility
  firstName         String
  fatherName        String // Ethiopian naming: given name + father's name + grandfather's name
  grandfather       String?
  firstNameAm       String?
  fatherNameAm      String?
  sex               Sex
  dateOfBirth       DateTime?
  /// Worked out from an age the patient gave, not a known birth date.
  dobEstimated      Boolean   @default(false)
  phone             String?
  /// Other address details or a landmark, besides the structured address below.
  address           String?
  region            String?
  /// Zone, or sub-city in Addis Ababa and Dire Dawa.
  zone              String?
  woreda            String?
  kebele            String?
  houseNo           String?
  /// Fayda national ID number (digits only), one patient per number in a clinic.
  nationalId        String?
  nextOfKinName     String?
  nextOfKinRelation String?
  nextOfKinPhone    String?
  familyId          String? // links household members
  /// A duplicate record merged into another: kept (its MRN still finds the patient) but hidden.
  mergedIntoId      String?
  mergedInto        Patient?  @relation("PatientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom        Patient[] @relation("PatientMerge")
  mergedAt          DateTime?
  allergies         String[]
  createdAt         DateTime  @default(now())

  appointments      Appointment[]
  visits            Visit[]
  invoices          Invoice[]
  coverages         PatientCoverage[]
  problems          PatientProblem[]
  immunizations     ImmunizationDose[]
  immunizationCalls ImmunizationFollowUp[]
  aefis             ImmunizationAefi[]
  fpRecords         FpRecord[]
  pregnancies       Pregnancy[]

  @@unique([tenantId, mrn])
  @@unique([tenantId, nationalId])
  @@index([tenantId, phone])
  @@index([tenantId, familyId])
}

/// A vaccine dose (or vitamin A) given here, or recorded from the patient's card when given
/// elsewhere. A mistaken entry is voided with a reason, never deleted.
model ImmunizationDose {
  id         String    @id @default(uuid())
  tenantId   String
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// A key of VACCINES in the API (BCG, OPV, PENTA, PCV, ROTA, IPV, MCV, HPV, TD, VITA).
  vaccine    String
  doseNo     Int
  givenOn    DateTime  @db.Date
  lotNo      String?
  site       String?
  /// Given at another facility, recorded from the card.
  elsewhere  Boolean   @default(false)
  facility   String?
  note       String?
  givenById  String
  createdAt  DateTime  @default(now())
  voidedAt   DateTime?
  voidReason String?
  voidedById String?
  aefis      ImmunizationAefi[]

  @@index([patientId])
  @@index([tenantId, givenOn])
}

/// Family planning: each service given to a client, a method started, resupplied, removed (implant,
/// IUCD) or stopped. The client's current method and next due date are worked out from these.
/// A mistaken entry is voided with a reason, never deleted.
model FpRecord {
  id          String    @id @default(uuid())
  tenantId    String
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  givenOn     DateTime  @db.Date
  /// START, RESUPPLY, REMOVAL or STOP.
  service     String
  /// A key of FP_METHODS in the API (COC, DMPA_IM, IMPLANT_5Y, IUCD, CONDOM_MALE…).
  method      String
  /// NEW (her first modern method ever) or REPEAT; null for removals and stops.
  clientType  String?
  /// Cycles of pills, condoms, doses; null where it doesn't apply.
  quantity    Int?
  /// When she should come back: resupply, or the device's removal or replacement.
  nextDueOn   DateTime? @db.Date
  /// Why a device was removed or a method stopped.
  reason      String?
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?
  voidReason  String?
  voidedById  String?

  @@index([patientId])
  @@index([tenantId, givenOn])
}

/// An adverse event following immunization (AEFI): what happened after a dose, how serious, how it
/// ended, and whether it was reported to the woreda (serious ones must be, within a day).
model ImmunizationAefi {
  id          String            @id @default(uuid())
  tenantId    String
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// The dose it followed, when known (the vaccine name stays on the dose).
  doseId      String?
  dose        ImmunizationDose? @relation(fields: [doseId], references: [id])
  onsetOn     DateTime          @db.Date
  /// Keys of AEFI_SIGNS in the API.
  signs       String[]
  /// Death, hospital admission, disability, or life-threatening: reported at once.
  serious     Boolean           @default(false)
  /// RECOVERED, RECOVERING, NOT_RECOVERED, DIED or UNKNOWN.
  outcome     String
  reportedTo  String?
  reportedOn  DateTime?         @db.Date
  note        String?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([patientId])
  @@index([tenantId, onsetOn])
}

/// A call or visit to a child who missed a vaccine: what came of it. Never changed.
model ImmunizationFollowUp {
  id          String   @id @default(uuid())
  tenantId    String
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// WILL_COME, NO_ANSWER, WRONG_NUMBER, VACCINATED_ELSEWHERE or MOVED_AWAY
  outcome     String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([patientId])
}

/// A pregnancy followed in antenatal care, from registration to its end (delivery, loss, transfer).
/// The due date comes from the last period, or from an ultrasound (then the period is worked back).
model Pregnancy {
  id          String       @id @default(uuid())
  tenantId    String
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lmp         DateTime     @db.Date
  edd         DateTime     @db.Date
  /// LMP or ULTRASOUND
  eddSource   String       @default("LMP")
  gravida     Int
  para        Int
  /// Keys of RISK_FACTORS in the API, ticked at registration or later.
  riskFactors String[]
  bloodGroup  String?
  /// ACTIVE, DELIVERED or ENDED
  status      String       @default("ACTIVE")
  /// DELIVERED, DELIVERED_ELSEWHERE, MISCARRIAGE, ABORTION, STILLBIRTH, TRANSFERRED, LOST_TO_FOLLOW_UP
  outcome     String?
  endedOn     DateTime?    @db.Date
  createdById String
  createdAt   DateTime     @default(now())
  contacts    AncContact[]

  @@index([patientId])
  @@index([tenantId, status])
}

/// One antenatal contact: what was measured, tested and given, and when the next is due.
model AncContact {
  id             String    @id @default(uuid())
  tenantId       String
  pregnancyId    String
  pregnancy      Pregnancy @relation(fields: [pregnancyId], references: [id], onDelete: Cascade)
  visitId        String?
  contactNo      Int
  contactOn      DateTime  @db.Date
  gaWeeks        Int
  gaDays         Int
  weightKg       Decimal?  @db.Decimal(5, 2)
  systolicBp     Int?
  diastolicBp    Int?
  fundalHeightCm Int?
  fetalHeartRate Int?
  /// CEPHALIC, BREECH or TRANSVERSE (from about 36 weeks)
  presentation   String?
  /// NEGATIVE, TRACE, PLUS1, PLUS2, PLUS3
  urineProtein   String?
  hb             Decimal?  @db.Decimal(4, 1)
  /// NEGATIVE, POSITIVE or NOT_DONE
  syphilis       String?
  hiv            String?
  hbsag          String?
  /// Keys of DANGER_SIGNS in the API.
  dangerSigns    String[]
  /// Iron-folic acid tablets given at this contact.
  ifaTablets     Int?
  dewormed       Boolean   @default(false)
  note           String?
  nextContactOn  DateTime  @db.Date
  createdById    String
  createdAt      DateTime  @default(now())
  /// Recorded by mistake (wrong woman, wrong day): kept, marked void with the reason, and left out
  /// of the contact count, the next contact and the monthly report.
  voidedAt       DateTime?
  voidReason     String?
  voidedById     String?

  @@index([pregnancyId])
  @@index([tenantId, contactOn])
}

// ───────────────────────────── Appointments & queue ─────────────────────────────

enum AppointmentStatus {
  BOOKED
  ARRIVED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String?
  doctor          User?             @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  scheduledAt     DateTime
  reason          String?
  status          AppointmentStatus @default(BOOKED)
  /// The reminder call: when, by whom, and what came of it (CONFIRMED, NO_ANSWER, CANNOT_COME, WRONG_NUMBER).
  reminderSentAt  DateTime?
  reminderOutcome String?
  reminderById    String?
  /// A missed appointment followed up: REBOOKED, WILL_COME, NO_ANSWER, WRONG_NUMBER or DECLINED.
  traceOutcome    String?
  traceNote       String?
  tracedAt        DateTime?
  tracedById      String?
  createdAt       DateTime          @default(now())

  visit Visit?

  @@index([tenantId, scheduledAt])
}

// One row per facility per clinic day; incremented atomically to hand out queue numbers.
model QueueCounter {
  tenantId String
  day      DateTime @db.Date
  last     Int

  @@id([tenantId, day])
}

// ───────────────────────────── Visits / EMR (OPD) ─────────────────────────────

enum VisitStatus {
  WAITING // in the queue
  IN_CONSULTATION
  AWAITING_LAB
  AWAITING_PHARMACY
  COMPLETED
  CANCELLED
}

model Visit {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  patientId       String
  patient         Patient      @relation(fields: [patientId], references: [id])
  doctorId        String?
  doctor          User?        @relation("VisitDoctor", fields: [doctorId], references: [id])
  appointmentId   String?      @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  queueNumber     Int
  // WALK_IN: a pharmacy counter sale with no consultation; kept out of the queue and OPD reports.
  kind            VisitKind    @default(OPD)
  status          VisitStatus  @default(WAITING)
  /// Where the patient was referred from (a health post, another clinic), if anyone.
  referredFrom    String?
  /// Why a cancelled visit was cancelled (LEFT_WITHOUT_BEING_SEEN, CANNOT_PAY, SENT_ELSEWHERE, CHECKED_IN_BY_MISTAKE, OTHER).
  cancelReason    String?
  /// Billed to a credit company or insurer (the patient's coverage, chosen at check-in): covered
  /// charges go to them at their tariff, and the patient pays the co-payment.
  payerId         String?
  payer           Payer?       @relation(fields: [payerId], references: [id])
  memberId        String?
  authorizationNo String?
  coPayPercent    Decimal?     @db.Decimal(5, 2)
  checkedInAt     DateTime     @default(now())
  calledAt        DateTime? // when the doctor first called the patient in
  completedAt     DateTime?

  // vitals
  temperatureC    Decimal?  @db.Decimal(4, 1)
  pulse           Int?
  systolicBp      Int?
  diastolicBp     Int?
  respRate        Int?
  spo2            Int?
  weightKg        Decimal?  @db.Decimal(5, 2)
  heightCm        Decimal?  @db.Decimal(5, 1)
  /// Mid-upper arm circumference (mm): malnutrition screening for children 6–59 months, and for
  /// pregnant and breastfeeding women.
  muacMm          Int?
  /// Triage priority set by the nurse: RED (emergency), ORANGE (very urgent), YELLOW (urgent),
  /// GREEN (routine). The queue is seen in this order, then by arrival.
  triageLevel     String?
  triagedAt       DateTime?
  triagedById     String?
  /// For women who could be pregnant: NOT_PREGNANT, POSSIBLE or PREGNANT (with the first day of the
  /// last period), and breastfeeding. Prescribing checks the drugs against them.
  pregnancyStatus String?
  lmpDate         DateTime? @db.Date
  breastfeeding   Boolean?

  chiefComplaint String?
  history        String?
  examination    String?
  plan           String?
  /// Advice for the patient in plain words, printed on their visit summary.
  patientAdvice  String?

  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  charges       Charge[]
  addenda       VisitAddendum[]
  notifications DiseaseNotification[]
  invoices      Invoice[]
  documents     ClinicalDocument[]

  @@index([tenantId, checkedInAt])
  @@index([tenantId, status])
}

model Diagnosis {
  id        String  @id @default(uuid())
  visitId   String
  visit     Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  icd11Code String
  label     String
  isPrimary Boolean @default(false)
}

/// A condition the patient lives with (hypertension, diabetes, HIV, epilepsy…), kept on their record
/// across visits and shown at every consultation until it is resolved.
model PatientProblem {
  id          String    @id @default(uuid())
  tenantId    String
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  icd11Code   String?
  label       String
  /// ACTIVE or RESOLVED
  status      String    @default("ACTIVE")
  since       DateTime? @db.Date
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([patientId])
  @@index([tenantId, status])
}

/// A note added to a visit afterwards (a result reviewed, a phone call): signed and timed, never
/// edited, so the original record stays as it was.
model VisitAddendum {
  id        String   @id @default(uuid())
  tenantId  String
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  text      String
  authorId  String
  createdAt DateTime @default(now())

  @@index([visitId])
}

/// A case of an immediately reportable disease (IDSR) phoned through to the woreda health office:
/// who reported it, to whom and when. Recorded once per disease per visit and never changed.
model DiseaseNotification {
  id           String   @id @default(uuid())
  tenantId     String
  visitId      String
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// A key of NOTIFIABLE in the API (MEASLES, CHOLERA…).
  disease      String
  reportedTo   String
  note         String?
  reportedById String
  reportedAt   DateTime @default(now())

  @@unique([visitId, disease])
  @@index([tenantId, reportedAt])
}

// ───────────────────────────── Prescriptions & pharmacy ─────────────────────────────

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

model Prescription {
  id             String             @id @default(uuid())
  visitId        String
  visit          Visit              @relation(fields: [visitId], references: [id])
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  prescriberId   String
  prescriber     User               @relation(fields: [prescriberId], references: [id])
  status         PrescriptionStatus @default(PENDING)
  alerts         Json? // allergy / interaction alerts the prescriber saw and accepted
  overrideReason String? // required when an allergy alert was overridden
  createdAt      DateTime           @default(now())
  dispensedAt    DateTime?
  items          PrescriptionItem[]

  @@index([tenantId, status])
}

model PrescriptionItem {
  id                 String       @id @default(uuid())
  prescriptionId     String
  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drugId             String
  drug               Drug         @relation(fields: [drugId], references: [id])
  dose               String // "500 mg"
  frequency          String // "TID"
  durationDays       Int?
  quantity           Int
  instructions       String?
  billedQty          Int          @default(0) // units already charged (sent to the cashier)
  dispensedQty       Int          @default(0)
  /// Units the patient brought back after they were handed over (dispensedQty is not reduced).
  returnedQty        Int          @default(0)
  /// Of those, units whose charge was taken back: refunded, or dropped before it was invoiced.
  refundedQty        Int          @default(0)
  /// Set when the pharmacist gave an equivalent (same generic, strength and form; another brand) instead: what was prescribed, and why.
  substitutedFrom    String?
  substitutionReason String?
  returns            DrugReturn[]
}

/// A place stock is kept: the main store, the dispensary, a ward. Dispensing takes only from dispensary stores.
model Store {
  id         String       @id @default(uuid())
  tenantId   String
  name       String
  dispensary Boolean      @default(false)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  batches    StockBatch[]

  @@unique([tenantId, name])
}

/// Stock moved between the clinic's stores; each unit moved is a pair of stock movements (out, in).
model StockTransfer {
  id          String   @id @default(uuid())
  tenantId    String
  number      String
  fromStoreId String
  toStoreId   String
  note        String?
  userId      String
  createdAt   DateTime @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
}

/// The returns register: drugs a patient brought back to the pharmacy.
model DrugReturn {
  id                 String           @id @default(uuid())
  tenantId           String
  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  quantity           Int
  /// Sealed and fit to sell again: put back on the shelf. Otherwise kept aside for destruction.
  restocked          Boolean
  reason             String
  userId             String
  createdAt          DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([prescriptionItemId])
}

model Drug {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  genericName  String
  brandName    String?
  drugClass    String? // e.g. "penicillin", "nsaid"; used to match allergies and interactions
  form         String // tablet, syrup, injection…
  strength     String?
  unit         String // unit of dispensing
  sellPrice    Decimal          @db.Decimal(12, 2)
  reorderLevel Int              @default(0)
  /// Units in one pack as bought (100 tablets in a box); stock is still kept in units.
  packSize     Int?
  /// What the pack is called: box, strip, bottle…
  packName     String?
  /// Narcotic or psychotropic: every unit in and out goes in the controlled-drug register.
  controlled   ControlledClass?
  active       Boolean          @default(true)

  batches           StockBatch[]
  prescriptionItems PrescriptionItem[]
  purchaseLines     PurchaseOrderLine[]

  @@index([tenantId, genericName])
}

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  phone         String?
  contactPerson String?
  tin           String? // Ethiopian taxpayer identification number
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  batches        StockBatch[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, name])
}

model StockBatch {
  id           String    @id @default(uuid())
  drugId       String
  drug         Drug      @relation(fields: [drugId], references: [id])
  batchNo      String
  expiryDate   DateTime
  quantity     Int
  costPrice    Decimal   @db.Decimal(12, 2)
  supplier     String? // free-text supplier name (seed / legacy); new receipts use supplierId
  supplierId   String?
  supplierRef  Supplier? @relation(fields: [supplierId], references: [id])
  receiptRef   String? // supplier invoice or delivery note number
  receivedById String?
  receivedAt   DateTime  @default(now())
  /// Where the batch is kept (multi-store clinics); null in a clinic with one store.
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id])

  movements StockMovement[]

  @@index([drugId, expiryDate]) // first-expiry-first-out lookups
  @@index([storeId])
}

/// Drugs under special control (Ethiopian Food and Drug Authority): kept in a register with a running balance.
enum ControlledClass {
  NARCOTIC
  PSYCHOTROPIC
}

enum StockMovementType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  EXPIRED
  TRANSFER_OUT
  TRANSFER_IN
  RETURN // brought back by a patient and put back on the shelf
}

model StockMovement {
  id        String            @id @default(uuid())
  batchId   String
  batch     StockBatch        @relation(fields: [batchId], references: [id])
  type      StockMovementType
  quantity  Int // positive in, negative out
  reference String? // prescription item id, PO number…
  reason    String? // for adjustments: DAMAGED, LOST, COUNT_CORRECTION, RETURNED_TO_SUPPLIER, OTHER (+ note)
  userId    String?
  createdAt DateTime          @default(now())
}

// ───────────────────────────── Lab ─────────────────────────────

model LabTest {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  name          String
  loincCode     String?
  unit          String?
  refLow        Decimal?         @db.Decimal(12, 3)
  refHigh       Decimal?         @db.Decimal(12, 3)
  price         Decimal          @db.Decimal(12, 2)
  /// Critical (panic) limits: a result beyond them is called to the doctor at once.
  critLow       Decimal?         @db.Decimal(12, 3)
  critHigh      Decimal?         @db.Decimal(12, 3)
  // For qualitative tests (e.g. malaria film): the allowed answers. Empty = numeric or free text.
  resultOptions String[]
  active        Boolean          @default(true)
  /// Target turnaround, sample taken to result released (minutes); empty = no target.
  tatMinutes    Int?
  /// What the sample is and the tube or container it goes in (EDTA, SERUM, URINE…); tests with the same one share a tube.
  specimen      String?
  /// Not done here: the sample goes to a reference lab (usually this one).
  sendOut       Boolean          @default(false)
  referenceLab  String?
  /// Ranges for men, women and age groups; the test's own range is the default.
  ranges        LabRange[]
  qcControls    LabQcControl[]
  reagents      LabTestReagent[]

  orders     LabOrder[]
  // A panel (CBC, urinalysis…) has several components, each with its own range or answers; the
  // test's own unit/range/options are then unused.
  components LabTestComponent[]
}

model LabTestComponent {
  id            String   @id @default(uuid())
  tenantId      String
  labTestId     String
  labTest       LabTest  @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  name          String
  unit          String?
  refLow        Decimal? @db.Decimal(12, 3)
  refHigh       Decimal? @db.Decimal(12, 3)
  critLow       Decimal? @db.Decimal(12, 3)
  critHigh      Decimal? @db.Decimal(12, 3)
  resultOptions String[]
  sortOrder     Int      @default(0)

  values LabResultValue[]
  ranges LabRange[]

  @@index([labTestId])
}

/**
 * One component's result in a panel test.
 */
model LabResultValue {
  id          String           @id @default(uuid())
  tenantId    String
  labOrderId  String
  labOrder    LabOrder         @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  componentId String
  component   LabTestComponent @relation(fields: [componentId], references: [id])
  value       String
  flag        String? // HH, H, N, L, LL (numeric components only; double = critical)
  /// The range this result was judged against, as printed ("13–17 g/dL (men)").
  rangeText   String?

  @@unique([labOrderId, componentId])
}

/// A reference (and critical) range for men or women and/or an age group. The most specific range
/// that fits the patient wins; the test's or component's own range applies otherwise.
model LabRange {
  id          String            @id @default(uuid())
  tenantId    String
  labTestId   String?
  labTest     LabTest?          @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  componentId String?
  component   LabTestComponent? @relation(fields: [componentId], references: [id], onDelete: Cascade)
  sex         Sex?
  /// Age band in days, from (inclusive) to (exclusive; null = no upper limit).
  ageFromDays Int               @default(0)
  ageToDays   Int?
  refLow      Decimal?          @db.Decimal(12, 3)
  refHigh     Decimal?          @db.Decimal(12, 3)
  critLow     Decimal?          @db.Decimal(12, 3)
  critHigh    Decimal?          @db.Decimal(12, 3)

  @@index([labTestId])
  @@index([componentId])
}

/// A released result that was corrected: what it said before, and why it changed.
model LabAmendment {
  id             String   @id @default(uuid())
  tenantId       String
  labOrderId     String
  labOrder       LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  previousValue  String?
  previousFlag   String?
  previousValues Json?
  reason         String
  userId         String
  createdAt      DateTime @default(now())

  @@index([labOrderId])
}

/// A sample the lab could not use (haemolysed, clotted, too little…): a new one is collected.
model LabSampleRejection {
  id         String   @id @default(uuid())
  tenantId   String
  labOrderId String
  labOrder   LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  sampleId   String?
  reason     String
  note       String?
  userId     String
  createdAt  DateTime @default(now())

  @@index([labOrderId])
  @@index([tenantId, createdAt])
}

/// A control material run to check a test gives right answers: a QC level with a target mean and
/// SD, or a rapid kit's positive or negative control with the answer it must give.
model LabQcControl {
  id        String        @id @default(uuid())
  tenantId  String
  labTestId String
  labTest   LabTest       @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  name      String // "Level 1 (normal)", "Positive control"
  lot       String?
  expiresAt DateTime?
  mean      Decimal?      @db.Decimal(12, 3)
  sd        Decimal?      @db.Decimal(12, 3)
  expected  String? // qualitative controls: the answer it must give
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  results   LabQcResult[]

  @@index([tenantId, labTestId])
}

/// One run of a control: its value, how far from the mean, and the verdict by the Westgard rules.
model LabQcResult {
  id        String       @id @default(uuid())
  tenantId  String
  controlId String
  control   LabQcControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  value     String
  z         Decimal?     @db.Decimal(8, 3) // standard deviations from the mean
  /// PASS; WARN (1-2s: look closer, results may go out); FAIL (patient results held until a passing run).
  status    String
  rule      String? // the rule broken: 1-2s, 1-3s, 2-2s, R-4s, 4-1s, 10x, or "expected Negative"
  note      String?
  action    String? // what was done about a failure (new reagent, recalibration…)
  userId    String
  createdAt DateTime     @default(now())

  @@index([controlId, createdAt])
  @@index([tenantId, createdAt])
}

/// Lab supplies kept in stock: test kits, strips, reagent packs (counted in whole units).
model LabReagent {
  id           String               @id @default(uuid())
  tenantId     String
  name         String
  unit         String // "test", "strip", "pack"
  reorderLevel Int                  @default(0)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  lots         LabReagentLot[]
  uses         LabTestReagent[]
  movements    LabReagentMovement[]

  @@unique([tenantId, name])
}

model LabReagentLot {
  id         String               @id @default(uuid())
  tenantId   String
  reagentId  String
  reagent    LabReagent           @relation(fields: [reagentId], references: [id], onDelete: Cascade)
  lot        String?
  expiresAt  DateTime?
  quantity   Int // on hand, never below zero
  receivedAt DateTime             @default(now())
  movements  LabReagentMovement[]

  @@index([reagentId])
}

/// Every change to reagent stock, never edited: received, used by a test or QC run, counted, expired.
model LabReagentMovement {
  id         String         @id @default(uuid())
  tenantId   String
  reagentId  String
  reagent    LabReagent     @relation(fields: [reagentId], references: [id], onDelete: Cascade)
  /// Null when a test used more than the stock on record (a count to correct).
  lotId      String?
  lotRow     LabReagentLot? @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type       String // RECEIVE, USE, QC, ADJUST, EXPIRED
  quantity   Int // signed: + in, - out
  labOrderId String?
  reason     String?
  userId     String?
  createdAt  DateTime       @default(now())

  @@index([reagentId, createdAt])
  @@index([tenantId, createdAt])
}

/// What a test uses: so many units of a reagent per test (and per QC run).
model LabTestReagent {
  id        String     @id @default(uuid())
  tenantId  String
  labTestId String
  labTest   LabTest    @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  reagentId String
  reagent   LabReagent @relation(fields: [reagentId], references: [id], onDelete: Cascade)
  perTest   Int        @default(1)

  @@unique([labTestId, reagentId])
  @@index([reagentId])
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  RESULTED
  VERIFIED
  CANCELLED
}

model LabOrder {
  id                 String               @id @default(uuid())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  visitId            String
  visit              Visit                @relation(fields: [visitId], references: [id])
  labTestId          String
  labTest            LabTest              @relation(fields: [labTestId], references: [id])
  orderedById        String
  orderedBy          User                 @relation(fields: [orderedById], references: [id])
  status             LabOrderStatus       @default(ORDERED)
  /// Lab-only visits: who asked for the test (a doctor or clinic outside), if anyone.
  requestedBy        String?
  /// Needed now (STAT): first on the bench, with a shorter turnaround target.
  urgent             Boolean              @default(false)
  sampleId           String?
  sampleCollectedAt  DateTime?
  /// Sent to a reference lab: where, its number for the sample there, when and by whom. The result is entered when it comes back.
  sentTo             String?
  sentRef            String?
  sentAt             DateTime?
  sentById           String?
  collectedById      String?
  collectedBy        User?                @relation("LabCollectedBy", fields: [collectedById], references: [id])
  resultValue        String?
  resultFlag         String? // HH, H, N, L, LL (numeric only; double letters = critical)
  /// The range the result was judged against, as printed (single-value tests).
  rangeText          String?
  /// A result beyond a critical limit: phoned to the doctor before it is released.
  critical           Boolean              @default(false)
  /// Who was told of the critical result, how and when (written by the lab at verification).
  criticalNotified   String?
  criticalNotifiedAt DateTime?
  /// Needs the doctor's attention: CRITICAL result, or AMENDED after release; cleared when they mark it seen.
  alert              String?
  alertSeenAt        DateTime?
  alertSeenById      String?
  amendedAt          DateTime?
  /// Samples rejected for this order (haemolysed, clotted…); the last reason, while a new one is awaited.
  rejections         Int                  @default(0)
  rejectReason       String?
  resultNote         String?
  orderedAt          DateTime             @default(now())
  resultedAt         DateTime?
  resultedById       String?
  resultedBy         User?                @relation("LabResultedBy", fields: [resultedById], references: [id])
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?                @relation("LabVerifiedBy", fields: [verifiedById], references: [id])
  values             LabResultValue[] // panel tests: one per component
  amendments         LabAmendment[]
  sampleRejections   LabSampleRejection[]

  @@index([tenantId, status])
}

// ───────────────────────────── Billing ─────────────────────────────

model ServiceItem {
  id       String      @id @default(uuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  code     String
  name     String
  price    Decimal     @db.Decimal(12, 2)
  // CONSULTATION: a fee taken at check-in. PROCEDURE: given during the visit (injection, dressing, ECG…).
  kind     ServiceKind @default(CONSULTATION)
  active   Boolean     @default(true)

  @@unique([tenantId, code])
}

enum ServiceKind {
  CONSULTATION
  PROCEDURE
}

enum VisitKind {
  OPD
  WALK_IN
  LAB // tests only: a request from another clinic, or the patient's own
}

/**
 * A credit company or insurer the clinic bills.
 */
model Payer {
  id                    String    @id @default(uuid())
  tenantId              String
  type                  PayerType // CREDIT or INSURANCE
  name                  String
  phone                 String?
  contactPerson         String?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  /// The patient's share of each covered bill (co-payment), in percent; the payer pays the rest.
  coPayPercent          Decimal   @default(0) @db.Decimal(5, 2)
  /// Each visit needs the payer's authorization (approval) number at check-in.
  requiresAuthorization Boolean   @default(false)

  invoices  Invoice[]
  visits    Visit[]
  tariffs   PayerTariff[]
  coverages PatientCoverage[]
  charges   Charge[]

  @@unique([tenantId, name])
}

/**
 * A patient covered by a credit company or insurer: their member number, and until when.
 */
model PatientCoverage {
  id         String    @id @default(uuid())
  tenantId   String
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  payerId    String
  payer      Payer     @relation(fields: [payerId], references: [id])
  memberId   String?
  /// For a dependant: the employee or member they are covered through ("Spouse of Abebe K.").
  holder     String?
  validUntil DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([patientId])
  @@index([tenantId, payerId])
}

/**
 * A payer's own price for an item, or that the item isn't covered (the patient pays it).
 */
model PayerTariff {
  id       String   @id @default(uuid())
  tenantId String
  payerId  String
  payer    Payer    @relation(fields: [payerId], references: [id], onDelete: Cascade)
  itemType String // SERVICE, LAB, DRUG
  itemId   String
  price    Decimal? @db.Decimal(12, 2) // null: the clinic's own price
  excluded Boolean  @default(false)

  @@unique([payerId, itemType, itemId])
  @@index([tenantId])
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  tenantId    String
  number      String
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  note        String?
  createdById String
  createdAt   DateTime            @default(now())
  orderedAt   DateTime?
  closedAt    DateTime?
  lines       PurchaseOrderLine[]

  @@unique([tenantId, number])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  drugId          String
  drug            Drug          @relation(fields: [drugId], references: [id])
  quantity        Int
  unitCost        Decimal?      @db.Decimal(12, 2)
  receivedQty     Int           @default(0)
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTLY_RECEIVED
  RECEIVED
  CANCELLED
}

/**
 * Printed documents issued from a visit, kept for the record.
 */
model ClinicalDocument {
  id          String               @id @default(uuid())
  tenantId    String
  visitId     String
  visit       Visit                @relation(fields: [visitId], references: [id])
  type        ClinicalDocumentType
  data        Json
  createdById String
  createdAt   DateTime             @default(now())
  followUps   ReferralFollowUp[]
  /// Issued with a mistake: kept, marked void with the reason, and issued again correctly.
  voidedAt    DateTime?
  voidReason  String?
  voidedById  String?

  @@index([visitId])
}

/// What became of a referral: the patient arrived, feedback came back, they did not go, or just a
/// note (a call made). The latest entry is the referral's status; entries are never changed.
model ReferralFollowUp {
  id          String           @id @default(uuid())
  tenantId    String
  documentId  String
  document    ClinicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// SENT (a note only), ARRIVED, FEEDBACK_RECEIVED or DID_NOT_GO
  status      String
  note        String?
  createdById String
  createdAt   DateTime         @default(now())

  @@index([documentId])
}

enum ClinicalDocumentType {
  MEDICAL_CERTIFICATE
  REFERRAL
}

enum ChargeSource {
  CONSULTATION
  LAB
  PHARMACY
  PROCEDURE
  OTHER
}

// Every billable action creates a Charge automatically; charges are later grouped into an invoice.
model Charge {
  id          String       @id @default(uuid())
  visitId     String
  visit       Visit        @relation(fields: [visitId], references: [id])
  invoiceId   String?
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  source      ChargeSource
  sourceId    String? // lab order id, prescription item id…
  description String
  quantity    Int          @default(1)
  unitPrice   Decimal      @db.Decimal(12, 2)
  /// Covered by this payer (at its tariff); null = the patient pays it all.
  payerId     String?
  payer       Payer?       @relation(fields: [payerId], references: [id])
  createdAt   DateTime     @default(now())
  // Removed from its invoice because the service was never delivered (any overpayment refunded).
  voidedAt    DateTime?
  voidReason  String?
}

enum InvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum PayerType {
  SELF
  CREDIT
  INSURANCE
}

model Invoice {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id])
  visitId          String?
  visit            Visit?        @relation(fields: [visitId], references: [id])
  number           String
  payerType        PayerType     @default(SELF)
  payerName        String? // insurer or credit company (copied from the payer at invoicing)
  payerId          String?
  payer            Payer?        @relation(fields: [payerId], references: [id])
  status           InvoiceStatus @default(OPEN)
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  discountReason   String?
  /// Why it was reduced or waived, for reporting: STAFF, POOR (fee waiver), FOLLOW_UP (free
  /// follow-up), PROGRAMME (TB, HIV, family planning…), GOODWILL, OTHER.
  discountCategory String?
  /// Times the receipt was printed: a reprint says COPY.
  receiptPrints    Int           @default(0)
  total            Decimal       @db.Decimal(12, 2) // subtotal - discount
  paid             Decimal       @default(0) @db.Decimal(12, 2)
  /// A payer's invoice: the co-payment the patient pays at the counter, and how much of it is paid
  /// (the payer owes total - patientShare). Zero on the patient's own invoices.
  patientShare     Decimal       @default(0) @db.Decimal(12, 2)
  patientPaid      Decimal       @default(0) @db.Decimal(12, 2)
  createdById      String
  createdBy        User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  voidedAt         DateTime?
  voidReason       String?

  charges  Charge[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

// A cashier's end-of-day count: what the system expected in the drawer versus what was counted.
model CashClosing {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  cashierId    String
  cashier      User     @relation(fields: [cashierId], references: [id])
  day          DateTime @db.Date
  expectedCash Decimal  @db.Decimal(12, 2) // the float the shift started with + cash taken in it
  countedCash  Decimal  @db.Decimal(12, 2)
  totals       Json // per payment method, for the record
  note         String?
  /// A shift: from the cashier's last closing (or the start of the day) to this one. A cashier may
  /// close several shifts a day, handing over the cash each time.
  periodStart  DateTime @default(now())
  /// Change the drawer started with, and what is left in it for the next shift.
  openingFloat Decimal  @default(0) @db.Decimal(12, 2)
  floatLeft    Decimal  @default(0) @db.Decimal(12, 2)
  /// Who took the rest of the cash (the next cashier, the admin, the bank).
  handedTo     String?
  createdAt    DateTime @default(now())

  @@index([tenantId, cashierId, day])
}

enum PaymentMethod {
  CASH
  TELEBIRR
  CHAPA
  BANK_TRANSFER
}

model Payment {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  cashierId    String
  cashier      User          @relation(fields: [cashierId], references: [id])
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2) // negative for a refund
  reference    String? // Telebirr / Chapa transaction id
  note         String? // why a refund was given
  byPayer      Boolean       @default(false) // a settlement from the credit company or insurer
  /// This entry undoes another (a payment recorded by mistake): never edited, never twice.
  reversalOfId String?       @unique
  receivedAt   DateTime      @default(now())

  @@index([tenantId, receivedAt])
}

/// Written by the backup worker (deploy/postgres), read by Settings → Backups. Not per clinic:
/// one server's backups cover every clinic on it. The API's role may only read it.
enum BackupEventKind {
  BACKUP
  OFFSITE_SYNC
  CHECK
  RESTORE_TEST
  VERIFY
  ARCHIVE
  RESTORE
}

enum BackupEventStatus {
  OK
  WARNING
  FAILED
}

model BackupEvent {
  id         String            @id @default(uuid())
  kind       BackupEventKind
  status     BackupEventStatus
  detail     String? // full / diff / incr, local / offsite
  message    String?
  sizeBytes  BigInt?
  data       Json              @default("{}")
  site       String?
  startedAt  DateTime
  finishedAt DateTime          @default(now())

  @@index([kind, finishedAt])
  @@index([finishedAt])
}

/// Clinic server → cloud sync (apps/api/src/sync). While capture is on (SyncState.enabled, only on
/// a clinic server), a trigger on every clinic table writes each change here; the sync agent sends
/// the changes to the cloud and deletes them once the cloud has applied them.
model SyncOutbox {
  seq       BigInt              @id @default(autoincrement())
  /// The writing transaction: a change is sent only once every older transaction has finished.
  xid       Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))
  tableName String
  /// U = inserted or updated (row holds it), D = deleted (only key)
  op        String
  key       Json
  row       Json?
  at        DateTime            @default(now())
}

/// One row (id 1). On a clinic server: whether changes are captured, and how sending them is going.
model SyncState {
  id          Int       @id @default(1)
  enabled     Boolean   @default(false)
  enabledAt   DateTime?
  lastPushAt  DateTime?
  lastError   String?
  lastErrorAt DateTime?
  pushedRows  BigInt    @default(0)
}

/// On the cloud: one per clinic server allowed to send a clinic's data. While a clinic has an
/// active one, its cloud copy is read-only (the clinic server is where its data is entered).
model SyncClient {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  lastSeq     BigInt?
  appliedRows BigInt    @default(0)
  lastError   String?
  edgeVersion String?

  @@index([tenantId])
}

/// Replies to requests sent with an Idempotency-Key (offline work replayed by the browser): a
/// repeat of the same key gets the stored reply instead of doing the work twice. Kept 14 days.
model IdempotentRequest {
  tenantId  String
  key       String
  userId    String
  method    String
  path      String
  status    Int
  response  Json
  createdAt DateTime @default(now())

  @@id([tenantId, key])
  @@index([createdAt])
}

/// A waiting-room screen (TV). It holds its own key, which can only read the queue board (numbers
/// and doctors), never a staff session. Paired once with a short code from Settings → Screens.
model DisplayScreen {
  id               String    @id @default(uuid())
  tenantId         String
  name             String
  /// SHA-256 of the screen's key (the key itself lives only in the screen's cookie).
  tokenHash        String?   @unique
  /// SHA-256 of the 6-digit pairing code, while one is waiting to be used.
  pairingCodeHash  String?   @unique
  pairingExpiresAt DateTime?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?

  @@index([tenantId])
}

// ─── HMIS as a service: the platform (the cloud server only) ──────────────────────────────────
// Written only through the owner connection, by the platform console and the request flow. The
// application role can read a clinic's own subscription and invoices (row-level security) and the
// plans, nothing else. None of it is sent between clinic servers and the cloud (NOT_SYNCED).

enum DeploymentType {
  CLOUD // works on the HMIS cloud
  CLINIC_SERVER // its own server at the clinic, synced to the cloud
  ON_PREMISE // its own server, not connected to the cloud
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum ClinicRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlatformRole {
  OWNER // everything, including plans, prices, operators and settings
  BILLING // clinics, invoices and payments
  SUPPORT // looks at clinics and requests, approves requests
}

enum PlatformInvoiceStatus {
  OPEN
  PAID
  VOID
}

enum PlatformPaymentMethod {
  CHAPA
  TELEBIRR
  BANK_TRANSFER
  CASH
  OTHER
}

enum PlatformPaymentStatus {
  PENDING // reported by the clinic (a bank transfer), waiting for HMIS to confirm it
  CONFIRMED
  REJECTED
}

/// A subscription plan. Limits are enforced by the API; features name optional modules.
model Plan {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  description   String?
  priceMonthly  Decimal        @db.Decimal(12, 2)
  priceYearly   Decimal        @db.Decimal(12, 2)
  /// Active staff accounts allowed; null: no limit.
  maxStaff      Int?
  /// Optional modules: CREDIT (credit companies and insurance), PURCHASE_ORDERS, CLINIC_SERVER.
  features      String[]       @default([])
  /// Offered on the public request page and for new subscriptions.
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

/// One per clinic that HMIS bills. A clinic without one (development, a server installed before
/// HMIS was sold as a service) is not limited.
model Subscription {
  id            String             @id @default(uuid())
  tenantId      String             @unique
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  planId        String
  plan          Plan               @relation(fields: [planId], references: [id])
  deployment    DeploymentType     @default(CLOUD)
  status        SubscriptionStatus @default(TRIAL)
  billingCycle  BillingCycle       @default(MONTHLY)
  trialEndsAt   DateTime?
  /// The end of the last paid period. Null while ACTIVE: no end (a free or legacy clinic).
  paidUntil     DateTime?
  /// Days after the end during which everything still works (with warnings) before read-only.
  graceDays     Int                @default(14)
  /// Suspended by HMIS (e.g. a disputed payment), whatever the dates say.
  suspendedAt   DateTime?
  suspendReason String?
  cancelledAt   DateTime?
  cancelReason  String?
  /// The clinic's records were deleted (after cancellation); this row and HMIS's invoices stay.
  dataDeletedAt DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  invoices      PlatformInvoice[]
}

/// "We would like to use HMIS": sent from the public request page, reviewed by HMIS.
model ClinicRequest {
  id              String              @id @default(uuid())
  reference       String              @unique
  clinicName      String
  clinicNameAm    String?
  type            FacilityType        @default(CLINIC)
  region          String
  city            String
  address         String?
  licenceNumber   String?
  contactName     String
  contactPhone    String
  contactEmail    String?
  planCode        String?
  staffCount      Int?
  deployment      DeploymentType      @default(CLOUD)
  message         String?
  status          ClinicRequestStatus @default(PENDING)
  ip              String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectReason    String?
  /// The clinic created on approval.
  tenantId        String?
  /// The version (date) of the Terms of Service and Privacy Policy the requester accepted.
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt       DateTime            @default(now())

  @@index([status, createdAt])
}

/// HMIS staff who run the platform console. Separate from clinic staff: never in a clinic.
model PlatformUser {
  id                         String       @id @default(uuid())
  fullName                   String
  email                      String       @unique
  role                       PlatformRole @default(SUPPORT)
  passwordHash               String
  active                     Boolean      @default(true)
  mustChangePassword         Boolean      @default(true)
  /// A temporary password stops working after this.
  temporaryPasswordExpiresAt DateTime?
  sessionsValidAfter         DateTime?
  totpSecret                 String?
  totpPendingSecret          String?
  totpEnabledAt              DateTime?
  totpLastStep               Int?
  totpRecoveryCodes          String[]     @default([])
  lastSignInAt               DateTime?
  createdAt                  DateTime     @default(now())
}

model PlatformAuditLog {
  id         String   @id @default(uuid())
  operatorId String?
  action     String
  entity     String
  entityId   String?
  tenantId   String?
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
}

/// Platform-wide settings (a single row, id 1).
model PlatformSetting {
  id                Int      @id @default(1)
  trialDays         Int      @default(30)
  graceDays         Int      @default(14)
  /// Added to subscription invoices (Ethiopian VAT is 15%).
  vatPercent        Decimal  @default(15) @db.Decimal(5, 2)
  /// Shown to clinics paying by bank transfer: bank, account name and number.
  bankDetails       String?
  supportPhone      String?
  supportEmail      String?
  /// The seller printed on invoices to clinics: legal name, taxpayer number (TIN) and address.
  companyName       String?
  companyTin        String?
  companyAddress    String?
  nextInvoice       Int      @default(1)
  /// Issue each clinic's next invoice by itself, this many days before its trial or paid period ends.
  autoInvoice       Boolean  @default(true)
  invoiceDaysBefore Int      @default(10)
  /// A cancelled clinic's records can be deleted this many days after cancellation (time to export).
  dataRetentionDays Int      @default(60)
  updatedAt         DateTime @updatedAt
}

/// HMIS's own notes on a clinic: a call made, a promise to pay, anything the next operator should
/// know. With a follow-up day, it is on the console's to-do list until marked done.
model PlatformNote {
  id         String    @id @default(uuid())
  tenantId   String
  /// NOTE, CALL (a call to or from the clinic) or PROMISE (the clinic said it would pay by followUpOn).
  kind       String    @default("NOTE")
  body       String
  /// The start of the Addis Ababa day to come back to it.
  followUpOn DateTime?
  doneAt     DateTime?
  doneById   String?
  operatorId String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([followUpOn])
}

/// A message from HMIS shown at the top of the clinic app: maintenance, a new feature, a price change.
/// To every clinic (tenantId null) or one; between startsAt and endsAt; in English and Amharic.
model PlatformAnnouncement {
  id            String    @id @default(uuid())
  tenantId      String?
  /// INFO (can be dismissed) or WARNING (stays until it ends).
  tone          String    @default("INFO")
  title         String
  titleAm       String?
  body          String?
  bodyAm        String?
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  withdrawnAt   DateTime?
  withdrawnById String?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([startsAt])
}

/// The voice that calls patients on the waiting-room TVs: one short recording per word or phrase,
/// per language ("am", "en"), the same for every clinic. Recorded or uploaded in the platform
/// console; the TV joins them ("ተራ ቁጥር" + "አስራ ሁለት" + ...). Stored as trimmed mono WAV.
model VoiceClip {
  lang      String
  /// "number", "n1".."n19", "n20".."n90", "hundred", "go_to", "room", "enter", "come_in"
  key       String
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt

  @@id([lang, key])
}

/// HMIS's invoice to a clinic for one subscription period (not the clinic's invoices to patients).
model PlatformInvoice {
  id             String                @id @default(uuid())
  number         String                @unique
  tenantId       String
  subscriptionId String
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id])
  planName       String
  cycle          BillingCycle
  periodStart    DateTime
  periodEnd      DateTime
  subtotal       Decimal               @db.Decimal(12, 2)
  vat            Decimal               @db.Decimal(12, 2)
  total          Decimal               @db.Decimal(12, 2)
  status         PlatformInvoiceStatus @default(OPEN)
  dueDate        DateTime
  issuedAt       DateTime              @default(now())
  paidAt         DateTime?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  payments       PlatformPayment[]

  @@index([tenantId, issuedAt])
  @@index([status, dueDate])
}

model PlatformPayment {
  id           String                @id @default(uuid())
  invoiceId    String
  invoice      PlatformInvoice       @relation(fields: [invoiceId], references: [id])
  tenantId     String
  amount       Decimal               @db.Decimal(12, 2)
  method       PlatformPaymentMethod
  status       PlatformPaymentStatus @default(PENDING)
  /// Bank transaction number, Chapa tx_ref, Telebirr order id...
  reference    String?
  paidAt       DateTime
  /// The clinic staff member who reported it (PENDING), or the operator who recorded it.
  reportedById String?
  reviewedById String?
  reviewedAt   DateTime?
  rejectReason String?
  provider     Json?
  createdAt    DateTime              @default(now())

  @@unique([method, reference])
  @@index([tenantId, createdAt])
  @@index([status])
}

enum CheckoutStatus {
  CREATED // the clinic was sent to the provider's payment page
  PAID // the provider confirmed it; a PlatformPayment is recorded
  FAILED // the provider says it failed or was cancelled
  EXPIRED // never completed
}

/// An online payment of an invoice (Chapa or Telebirr), from the clinic leaving for the payment page
/// until the provider confirms it. Only ever marked paid after asking the provider ourselves.
model PlatformCheckout {
  id          String                @id @default(uuid())
  /// Our reference at the provider: Chapa tx_ref, Telebirr merch_order_id.
  reference   String                @unique
  provider    PlatformPaymentMethod
  invoiceId   String
  tenantId    String
  amount      Decimal               @db.Decimal(12, 2)
  status      CheckoutStatus        @default(CREATED)
  checkoutUrl String?
  createdById String?
  createdAt   DateTime              @default(now())
  checkedAt   DateTime?
  completedAt DateTime?
  paymentId   String?
  lastError   String?

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
}

/// The HMIS licence installed on a clinic server or own-server install (never on the HMIS cloud,
/// which keeps the subscriptions themselves). Signed by HMIS: see apps/api/src/licence.
model InstalledLicence {
  tenantId    String   @id
  /// The signed licence text, exactly as issued (payload.signature).
  licence     String
  licenceId   String
  issuedAt    DateTime
  /// "sync" (fetched from the HMIS cloud) or "upload" (a file from HMIS).
  source      String
  installedAt DateTime @default(now())
}
