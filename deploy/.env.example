# HMIS on a server. `sudo bash deploy/hmis install` writes .env from this file, with fresh random
# secrets; to do it by hand, copy it to .env (never commit .env), fill it in and keep it chmod 600.

# --- Address and HTTPS --------------------------------------------------------------------------
# The address people open: this server's IP on the clinic network, and/or its name, e.g.
# "192.168.1.10" or "192.168.1.10, hmis.lan"; on the cloud the domain, e.g. "hmis.example.et".
HMIS_SITE=
# "internal": certificates from this server's own authority, trusted once on each PC and tablet
# (docs/install/README.md). Or an email address: free public certificates for a domain that is
# reachable from the internet (the cloud server).
HMIS_TLS=internal
# HTTP_PORT=80
# HTTPS_PORT=443
# The private network of HMIS's containers; change only if it clashes with the clinic's network.
# HMIS_SUBNET=172.30.70.0/24

# The HMIS cloud only: 1 turns on the platform console (/platform), the public request page
# (/request) and subscriptions (docs/saas/README.md).
HMIS_PLATFORM=0
# The cloud's public address, e.g. https://hmis.example.et: Chapa and Telebirr send payers and
# payment reports back to it. Online payment stays off without it.
# HMIS_PUBLIC_URL=

# --- Online payment of subscriptions (HMIS cloud) ------------------------------------------------
# Chapa: the secret key from the Chapa dashboard (Settings → API). In the dashboard, set the webhook
# URL to <HMIS_PUBLIC_URL>/public/payments/chapa/webhook, with a webhook secret here.
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
# Telebirr H5 web checkout: from the Telebirr merchant portal (test first with its sandbox values).
# The private key is the merchant key registered with Telebirr, PEM with 
 for line breaks;
# the public key is Telebirr's, to check its payment notifications.
# TELEBIRR_API_URL=
# TELEBIRR_WEB_URL=
# TELEBIRR_FABRIC_APP_ID=
# TELEBIRR_APP_SECRET=
# TELEBIRR_MERCHANT_APP_ID=
# TELEBIRR_MERCHANT_CODE=
# TELEBIRR_PRIVATE_KEY=
# TELEBIRR_PUBLIC_KEY=

# HMIS licence (docs/saas/README.md). On a clinic server or own-server install that HMIS bills:
# HMIS_LICENCE=required (the installer asks). On the HMIS cloud only: the private key that signs
# licences, from `node dist/licence/cli.js keygen` (keep a printed copy in the safe).
# HMIS_LICENCE=
# HMIS_LICENCE_PRIVATE_KEY=

# --- Sign-in --------------------------------------------------------------------------------------
# Signs every sign-in: whoever knows it can sign in as anyone. openssl rand -base64 48
JWT_SECRET=

# --- Database -----------------------------------------------------------------------------------
# The superuser: only the database itself, the backup worker and administrators use it.
POSTGRES_USER=hmis
POSTGRES_PASSWORD=
POSTGRES_DB=hmis
# The API's roles (deploy/postgres/scripts/hmis-db-roles): hmis_owner owns the tables, hmis_app
# works under row-level security. At least 16 characters each: openssl rand -hex 24
HMIS_DB_OWNER_PASSWORD=
HMIS_DB_APP_PASSWORD=
TZ=Africa/Addis_Ababa
# DB_PORT=5432

# --- Clinic server → cloud (docs/sync/README.md) ---------------------------------------------------
# SYNC_CLOUD_URL=https://hmis.example.et
# SYNC_TOKEN=

# --- Backups ------------------------------------------------------------------------------------
# Name shown in alerts and on the status page; also the folder name off-site.
BACKUP_SITE_NAME=Demo Clinic server
# Encrypts every backup (AES-256). At least 24 characters: openssl rand -base64 36
# Without it the backups cannot be read. Keep a printed copy in the clinic's safe and one with
# the HMIS support team, never only on this server.
BACKUP_ENCRYPTION_KEY=
# The backup disk: a second physical disk mounted on the host (owned by uid 999).
# Leave unset only for testing: the backups would then sit on the same disk as the database.
# BACKUP_DISK=/mnt/backup

# Schedule (defaults shown). Full weekly, differential nightly, incremental every hour.
# BACKUP_NIGHT_HOUR=1
# BACKUP_FULL_DAYS=7
# BACKUP_INCR_MINUTES=60
# Point-in-time restore window on the backup disk, in days.
# BACKUP_RETENTION_DAYS=14
# RESTORE_TEST_DAYS=7
# RESTORE_TEST_OFFSITE_DAYS=30

# --- Off-site copy (S3-compatible storage with object lock, located in Ethiopia) ------------------
# Proclamation 1321/2024 art. 22: personal data collected in Ethiopia is stored in Ethiopia.
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=us-east-1
OFFSITE_S3_BUCKET=hmis-backups
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
# Folder for this site inside the bucket (default: derived from BACKUP_SITE_NAME).
# OFFSITE_S3_PREFIX=demo-clinic-server
# Where the copy physically is: shown on the status page and kept in the record of processing.
OFFSITE_LOCATION=
# Every how many minutes WAL and new backups are copied off-site.
# OFFSITE_SYNC_MINUTES=5
# Limit upload speed during clinic hours, e.g. "08:00,512k 18:00,off" (rclone --bwlimit).
# OFFSITE_BWLIMIT=
# OFFSITE_ALERT_HOURS=6

# --- Long-term archive (monthly pg_dump, encrypted to a public key) ------------------------------
# Generate a key pair on an offline machine with `age-keygen -o hmis-archive.key`; put the public
# key (age1...) here and keep the private key file off this server (USB in the safe + support team).
BACKUP_ARCHIVE_RECIPIENT=
# BACKUP_ARCHIVE_LOCAL_MONTHS=12

# --- Alerts -------------------------------------------------------------------------------------
# Telegram: create a bot with @BotFather, add it to the support group, put the group's chat id here.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Email through any SMTP server, e.g. smtps://user%40example.com:password@smtp.example.com:465
ALERT_SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# An outside monitor (healthchecks.io, Uptime Kuma...) pinged after every successful backup;
# it raises the alarm itself if the pings stop, even if this whole server is dead.
BACKUP_HEARTBEAT_URL=
