DATABASE_URL="postgresql://hmis:hmis_dev_password@localhost:5432/hmis?schema=public"
# The API's restricted role: queries run under PostgreSQL row-level security (one clinic per request).
# Created by the migrations; give it this password with `pnpm db:app-role`.
APP_DATABASE_URL="postgresql://hmis_app:hmis_app_dev_password@localhost:5432/hmis?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Optional: where the web server reaches the API at runtime (overrides NEXT_PUBLIC_API_URL)
# API_URL="http://localhost:4000"
# WEB_ORIGIN="http://localhost:3000"

# Clinic server only (docs/sync/README.md): send this clinic's changes to the HMIS cloud.
