DATABASE_URL="postgresql://hmis:hmis_dev_password@localhost:5432/hmis?schema=public"
# The API's restricted role: queries run under PostgreSQL row-level security (one clinic per request).
# Created by the migrations; give it this password with `pnpm db:app-role`.
APP_DATABASE_URL="postgresql://hmis_app:hmis_app_dev_password@localhost:5432/hmis?schema=public"
# Signs sign-ins: anyone who knows it can sign in as anyone. In production at least 32 random
# characters (openssl rand -base64 48); the API refuses to start with a weak one.
JWT_SECRET="change-me"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Optional: where the web server reaches the API at runtime (overrides NEXT_PUBLIC_API_URL)
# API_URL="http://localhost:4000"
# WEB_ORIGIN="http://localhost:3000"

# Clinic server only (docs/sync/README.md): send this clinic's changes to the HMIS cloud.
# SYNC_CLOUD_URL="https://cloud.example.et"
# SYNC_TOKEN=""
# SYNC_INTERVAL_MS=5000

# Addresses allowed to pass on the user's address (X-Forwarded-For) for the sign-in limits.
# This machine is always trusted; add the web container or reverse proxy when they run elsewhere.
# TRUSTED_PROXIES="172.18.0.3"
